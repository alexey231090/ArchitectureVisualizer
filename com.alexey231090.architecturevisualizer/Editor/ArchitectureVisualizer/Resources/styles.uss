.dependency-node {
    background-color: #2d2d2d;
    border-width: 1px;
    border-color: #444;
    border-radius: 5px;
    padding: 10px;
}

.dependency-node .title {
    color: #fff;
    font-size: 14px;
    -unity-font-style: bold;
}

.dependency-node .port {
    background-color: #3d3d3d;
    border-width: 1px;
    border-color: #555;
    border-radius: 3px;
    margin: 2px;
}

.dependency-node .port:hover {
    background-color: #4d4d4d;
}

.dependency-node .port.connected {
    background-color: #2a5c2a;
}

.dependency-node .port.disconnected {
    background-color: #5c2a2a;
}

.dependency-node .port-label {
    color: #ccc;
    font-size: 12px;
    margin: 2px;
}

.dependency-node .port-connector {
    background-color: #666;
    border-width: 1px;
    border-color: #888;
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.dependency-node .port-connector:hover {
    background-color: #888;
}

.dependency-node .port-connector.connected {
    background-color: #4a8a4a;
}

.dependency-node .port-connector.disconnected {
    background-color: #8a4a4a;
}

/* Стили для графа */
.graph-view {
    background-color: #1a1a1a;
}

.grid-background {
    background-color: #1a1a1a;
    background-image: resource("grid-pattern");
}

.grid-background-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    border-width: 0;
    border-color: #2a2a2a;
    border-right-width: 1px;
    border-bottom-width: 1px;
}

/* Стили для соединений */
.edge {
    border-color: #666;
    border-width: 2px;
}

.edge:hover {
    border-color: #888;
    border-width: 3px;
}

.edge.selected {
    border-color: #4a8a4a;
    border-width: 3px;
}

/* Event Tracking Styles */
.et-main-container {
    flex-direction: column;
}

.et-controls-container {
    flex-direction: row;
    margin-bottom: 10px;
}

.et-path-container {
    margin-bottom: 10px;
}

.et-path-container > .unity-foldout__input {
    font-size: 16px;
    -unity-font-style: bold;
    background-color: #383838;
}

.et-path-container > .unity-foldout__content {
    margin-left: 15px;
    margin-top: 5px;
}

.et-path-controls {
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 5px;
}

.et-steps-scrollview {
    /* Можно добавить стили для самого скролл-бара, если потребуется */
}

.et-steps-row {
    flex-direction: row;
    align-items: flex-start;
}

.et-step-column {
    flex-direction: column;
    width: auto;
    max-width: 100%;
    margin-right: 10px;
    padding: 10px;
    border-width: 1px;
    border-color: #1a1a1a;
    background-color: #282828;
    display: inline-flex;
}

.et-step-label {
    -unity-font-style: bold;
    white-space: nowrap;
}

.et-step-comment {
    white-space: normal;
    margin-top: 4px;
}

.et-values-container {
    margin-top: 5px;
}

.et-instance-container {
    margin-left: 10px;
    margin-top: 4px;
}

.et-instance-name {
    -unity-font-style: italic;
}

.et-value-label {
    margin-left: 10px;
    white-space: normal; /* Разрешаем перенос для значений */
}

/* --- Buttons --- */
.et-button {
    margin-right: 5px;
}

.et-button--add {
    background-color: #306030;
}
.et-button--add:hover {
    background-color: #408040;
}

.et-button--track {
    background-color: #2c5a2c;
}
.et-button--track:hover {
    background-color: #3c7a3c;
}

.et-button--stop {
    background-color: #803030;
}
.et-button--stop:hover {
    background-color: #a04040;
}

.et-button--danger {
    background-color: #8b3a3a;
}
.et-button--danger:hover {
    background-color: #ab4a4a;
} 